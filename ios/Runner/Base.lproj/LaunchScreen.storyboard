                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <!-- Native pre-Flutter launch screen, shown for the brief window
                             between the OS starting the app and the Flutter engine's
                             first frame (before SplashScreen in Dart ever gets a chance
                             to paint). A solid navy brand background instead of the
                             Flutter template's default white + generic Flutter logo, so
                             cold start never shows an unbranded screen. -->
                        <subviews/>
                        <color key="backgroundColor" red="0.0157" green="0.0784" blue="0.1569" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints/>
                    </view>
